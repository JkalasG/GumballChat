# Chat source: simulator, anonymous (read-only IRC, no token), or eventsub
# Any mode can read another public channel from the panel's connection bar.
CHAT_MODE=simulator

# Twitch EventSub (not used by the simulator or anonymous IRC mode)
TWITCH_CLIENT_ID=
TWITCH_OAUTH_TOKEN=
# Default channel shown in the panel; the panel can target another channel per connection.
TWITCH_CHANNEL_LOGIN=
# Connect to TWITCH_CHANNEL_LOGIN when the server starts (anonymous/eventsub modes). Set to false to connect manually.
TWITCH_AUTOCONNECT=true
TWITCH_BOT_LOGIN=

# Gemini API key from Google AI Studio. Keep this server-side in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Seconds Gemini may take before the local classifier answers instead (default 12000 ms).
GEMINI_TIMEOUT_MS=12000
# Reasoning effort sent to Gemini 3 models: minimal | low | high | default.
GEMINI_THINKING_LEVEL=minimal
STREAMER_LANGUAGE=es
UI_LANGUAGE=en

# Local app
PORT=3000
HOST=127.0.0.1

# Optional when hosting online: login for the panel and API (/login). The overlay and viewer pages stay public for OBS.
PANEL_USER=admin
PANEL_PASSWORD=
