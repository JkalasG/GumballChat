# Chat source: simulator, anonymous (experimental), or eventsub
CHAT_MODE=simulator

# Twitch EventSub (not used by the simulator or anonymous IRC mode)
TWITCH_CLIENT_ID=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL_LOGIN=
TWITCH_BOT_LOGIN=

# Gemini API key from Google AI Studio. Keep this server-side in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
STREAMER_LANGUAGE=es

# Local app
PORT=3000
